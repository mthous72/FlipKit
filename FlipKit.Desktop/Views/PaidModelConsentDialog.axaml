<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:FlipKit.Core.Services"
        x:Class="FlipKit.Desktop.Views.PaidModelConsentDialog"
        Title="Paid model required"
        Width="560" Height="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Border Padding="24" Background="{DynamicResource SystemRegionBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

            <TextBlock Grid.Row="0" Text="💳 Pick a paid model"
                       FontSize="18" FontWeight="Bold"/>

            <!-- Context message — explains why we're asking (free exhausted, paid as default, etc.) -->
            <TextBlock Grid.Row="1" x:Name="ContextMessage"
                       TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>

            <TextBlock Grid.Row="2" Text="Choose model for this scan:"
                       FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>

            <!-- Picker. Items are OpenRouterModel; ItemTemplate shows name + price.
                 Suggested model is pre-selected by the code-behind so a user who
                 trusts the suggestion can just hit Confirm. -->
            <ComboBox Grid.Row="3" x:Name="ModelPicker"
                      HorizontalAlignment="Stretch" Padding="10,6">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:OpenRouterModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <Border Background="#E8F5E9" CornerRadius="3" Padding="4,1"
                                    IsVisible="{Binding SupportsJsonSchema}"
                                    ToolTip.Tip="Supports strict json_schema — parallel name is constrained to the known list">
                                <TextBlock Text="✓ schema" FontSize="10" Foreground="#2E7D32"/>
                            </Border>
                            <TextBlock Text="—" Opacity="0.4"/>
                            <TextBlock Text="{Binding PromptPricePerMillion, StringFormat='${0:F2}/M prompt'}" FontSize="11" Opacity="0.7"/>
                            <TextBlock Text="·" Opacity="0.4"/>
                            <TextBlock Text="{Binding CompletionPricePerMillion, StringFormat='${0:F2}/M completion'}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Selected-model cost summary (uses ModelCostFormatter to estimate per-scan cost). -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1" CornerRadius="6" Padding="14"
                    Background="{DynamicResource SystemChromeLowColor}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SelectedModelName" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectedModelCost" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5" TextWrapping="Wrap" FontSize="11" Foreground="#B71C1C">
                ⚠️ Your OpenRouter account will be charged for this scan. Cancel
                to keep using free models only — your card data is unchanged.
            </TextBlock>

            <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Cancel (free models only)" Padding="20,8" />
                <Button x:Name="ProceedButton" Content="Use selected model"
                        Classes="accent" Padding="20,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
