<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FlipKit.Desktop.Views.PaidModelConsentDialog"
        Title="Paid model fallback"
        Width="520" Height="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Border Padding="24" Background="{DynamicResource SystemRegionBrush}">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="12">

            <TextBlock Grid.Row="0" Text="💳 Enable paid model fallback?"
                       FontSize="18" FontWeight="Bold"/>

            <TextBlock Grid.Row="1" x:Name="ContextMessage"
                       TextWrapping="Wrap" FontSize="13" Opacity="0.85"/>

            <Border Grid.Row="2" BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1" CornerRadius="6" Padding="14"
                    Background="{DynamicResource SystemChromeLowColor}">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="ProposedModelName" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProposedModelCost" FontSize="12" Opacity="0.85" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" TextWrapping="Wrap" FontSize="11" Opacity="0.65">
                Your OpenRouter account will be charged for this scan. The scan won't proceed
                if you cancel — your card data is unchanged.
            </TextBlock>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Free models only" Padding="20,8" />
                <Button x:Name="ProceedButton" Content="Enable paid fallback"
                        Classes="accent" Padding="20,8" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
