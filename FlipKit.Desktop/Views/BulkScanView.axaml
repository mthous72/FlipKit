<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipKit.Desktop.ViewModels"
             xmlns:conv="using:FlipKit.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="FlipKit.Desktop.Views.BulkScanView"
             x:DataType="vm:BulkScanViewModel">

    <UserControl.Resources>
        <conv:FilePathToBitmapConverter x:Key="FilePathToBitmapConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,24,24,60">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Bulk Scan" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Select multiple card images, scan them all, then review and save"
                       Opacity="0.6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content: Two columns -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="16">

            <!-- Left Column: Card List -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

                <!-- Controls -->
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                    <!-- Scan Mode -->
                    <TextBlock Text="Scan Mode" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ScanModeOptions}"
                              SelectedItem="{Binding SelectedScanModeOption}"
                              DisplayMemberBinding="{Binding Label}"
                              HorizontalAlignment="Stretch"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,-4,0,0"
                               IsVisible="{Binding IsOcrMode}">
                        Offline, free — no internet required. Accuracy varies; use Enhance for better results.
                    </TextBlock>
                    <!-- OCR unavailable warning -->
                    <Border Background="#FFEBEE" CornerRadius="4" Padding="8,6"
                            IsVisible="{Binding IsOcrModeUnavailable}">
                        <TextBlock Text="Windows OCR is not available on this system."
                                   Foreground="#B71C1C" FontSize="11" TextWrapping="Wrap"/>
                    </Border>

                    <!-- AI-only controls (hidden in OCR mode) -->
                    <StackPanel IsVisible="{Binding IsAiMode}" Spacing="8">
                        <!-- Model Selection -->
                        <TextBlock Text="AI Model" FontSize="12" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ModelOptions}"
                                  SelectedItem="{Binding SelectedModel}"
                                  IsEnabled="{Binding !IsLoadingModels}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModelOption">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                Background="#E3F2FD" CornerRadius="3" Padding="4,1"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowQualityPill}"
                                                ToolTip.Tip="{Binding ConfidenceLabel}">
                                            <TextBlock Text="{Binding QualityScoreDisplay}"
                                                       FontSize="10" Foreground="#0D47A1"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Loading model catalog..." FontSize="10" Opacity="0.6"
                                   IsVisible="{Binding IsLoadingModels}"/>
                        <TextBlock Text="{Binding ModelLoadError}" FontSize="10" Foreground="#E53935"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding ModelLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                        <!-- Concurrent Scans -->
                        <TextBlock Text="Concurrent Scans" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <NumericUpDown Value="{Binding MaxConcurrentScans}"
                                       Minimum="1" Maximum="8" Increment="1"
                                       HorizontalAlignment="Stretch"
                                       IsEnabled="{Binding !IsSelectedModelFree}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,-4,0,0"
                                   IsVisible="{Binding IsSelectedModelFree}">
                            Free models limited to 1 concurrent scan
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,-4,0,0"
                                   IsVisible="{Binding !IsSelectedModelFree}">
                            Paid models: Use 3-4 for best speed
                        </TextBlock>
                    </StackPanel>

                    <!-- Destination -->
                    <TextBlock Text="Save To" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding DestinationOptions}"
                              SelectedItem="{Binding SelectedDestinationOption}"
                              DisplayMemberBinding="{Binding Label}"
                              HorizontalAlignment="Stretch"/>

                    <!-- Saved Surprise Set picker — appears only when destination is Surprise Set.
                         Lists Draft sets only (Exported / Live / Completed reject AddCardAsync).
                         Inline "Create New Set…" opens NewSurpriseSetDialog and auto-selects the new set. -->
                    <StackPanel IsVisible="{Binding RequiresSetSelection}" Spacing="6">
                        <TextBlock Text="Surprise Set" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <ComboBox ItemsSource="{Binding AvailableSurpriseSets}"
                                  SelectedItem="{Binding SelectedSurpriseSet}"
                                  DisplayMemberBinding="{Binding Name}"
                                  PlaceholderText="Pick a Draft set…"
                                  HorizontalAlignment="Stretch"/>
                        <Button Content="Create New Set…"
                                Command="{Binding CreateSetInlineCommand}"
                                HorizontalAlignment="Stretch" Padding="8,4"/>
                        <TextBlock Text="Pick a set to enable Save All."
                                   FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                   IsVisible="{Binding SelectedSurpriseSet, Converter={x:Static ObjectConverters.IsNull}}"/>
                    </StackPanel>

                    <!-- Scan Depth -->
                    <TextBlock Text="Scan Depth" FontSize="12" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding ScanDepthOptions}"
                              SelectedItem="{Binding SelectedScanDepthOption}"
                              DisplayMemberBinding="{Binding Label}"
                              HorizontalAlignment="Stretch"/>
                    <TextBlock TextWrapping="Wrap" FontSize="10" Opacity="0.6">
                        Quick uses a minimal prompt — faster and cheaper for surprise set lots
                    </TextBlock>

                    <!-- Rate-limit banner -->
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="10,8"
                            IsVisible="{Binding IsRateLimitPaused}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding RateLimitBannerMessage}"
                                       TextWrapping="Wrap" FontSize="12" Foreground="#5D4037"/>
                            <Button Content="Resume Scan"
                                    Command="{Binding ResumeBulkScanCommand}"
                                    Padding="12,6" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Select Images" Command="{Binding SelectImagesCommand}"
                            HorizontalAlignment="Stretch" Classes="accent" Padding="12,8" Margin="0,8,0,0"/>
                    <CheckBox IsChecked="{Binding ImagesArePairs}"
                              Content="Images are front+back pairs"
                              FontSize="12"/>
                </StackPanel>

                <!-- Progress Bar (during scan) -->
                <StackPanel Grid.Row="1" IsVisible="{Binding IsScanning}" Spacing="4" Margin="0,0,0,8">
                    <ProgressBar Minimum="0" Maximum="{Binding ScanTotal}" Value="{Binding ScanProgress}"/>
                    <TextBlock FontSize="12" Opacity="0.7">
                        <Run Text="Scanning "/>
                        <Run Text="{Binding ScanProgress}"/>
                        <Run Text=" of "/>
                        <Run Text="{Binding ScanTotal}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.6"
                               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <!-- Card List -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem}"
                         x:CompileBindings="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- New 4-column grid: checkbox, thumbnail, info, index.
                                 The checkbox drives IsSelected (independent of
                                 ListBox SelectedItem) so a user can tick several
                                 cards without losing detail-pane focus. -->
                            <Grid ColumnDefinitions="Auto,36,*,Auto" Margin="4">
                                <CheckBox Grid.Column="0" Margin="0,0,6,0"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          ToolTip.Tip="Tick to include in 'Enhance Selected' / batch ops"/>
                                <!-- Thumbnail -->
                                <Image Grid.Column="1" Width="28" Height="28" Stretch="UniformToFill"
                                       Source="{Binding FrontImagePath, Converter={StaticResource FilePathToBitmapConverter}}"/>
                                <!-- Name + status -->
                                <StackPanel Grid.Column="2" Margin="8,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="Red"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <!-- Low-confidence OCR banner -->
                                    <Border Background="#FFF8E1" CornerRadius="2" Padding="4,2" Margin="0,2,0,0"
                                            IsVisible="{Binding ShowLowConfidenceBanner}">
                                        <TextBlock Text="Low confidence — consider enhancing"
                                                   FontSize="10" Foreground="#5D4037"/>
                                    </Border>
                                </StackPanel>
                                <!-- Index -->
                                <TextBlock Grid.Column="3" Text="{Binding Index}" FontSize="11"
                                           Opacity="0.4" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right Column: Card Detail Form (when a scanned card is selected) -->
            <ScrollViewer Grid.Column="1" Padding="0,0,0,40">
                <StackPanel Spacing="8">

                    <!-- Card detail form (shown when a scanned item is selected) -->
                    <Border IsVisible="{Binding SelectedCard, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Spacing="8"
                                    x:CompileBindings="False"
                                    DataContext="{Binding SelectedCard}">

                            <TextBlock Text="Card Details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <!-- Identity -->
                            <TextBlock Text="Player Name" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PlayerName}" Watermark="Player Name"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Card #"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CardNumber}" Watermark="#"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Year"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Year}" Watermark="2024"/>
                            </Grid>

                            <TextBlock Text="Sport"/>
                            <!-- Bind against the enum-typed SportOptions list so
                                 selection assigns a Sport? to Card.Sport, not a
                                 string. The string-based ComboBoxItem flavor
                                 throws InvalidCastException at SelectedItem
                                 commit time. -->
                            <ComboBox ItemsSource="{x:Static vm:CardDetailViewModel.SportOptions}"
                                      SelectedItem="{Binding Sport}"
                                      HorizontalAlignment="Stretch"/>

                            <!-- Manufacturer -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Manufacturer}" Watermark="Panini"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Brand"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Brand}" Watermark="Prizm"/>
                            </Grid>

                            <TextBlock Text="Team"/>
                            <TextBox Text="{Binding Team}" Watermark="Team Name"/>

                            <!-- Variation -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Variation Type"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding VariationType}" Watermark="Base"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Parallel"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ParallelName}" Watermark="Silver"/>
                            </Grid>

                            <TextBlock Text="Serial Numbered"/>
                            <TextBox Text="{Binding SerialNumbered}" Watermark="/99"/>

                            <!-- Checkboxes -->
                            <WrapPanel Margin="0,4">
                                <CheckBox IsChecked="{Binding IsRookie}" Content="Rookie" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding IsAuto}" Content="Auto" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding IsRelic}" Content="Relic" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding IsShortPrint}" Content="SP" Margin="0,0,16,0"/>
                                <CheckBox IsChecked="{Binding IsSSP}" Content="SSP"/>
                            </WrapPanel>

                            <!-- Condition -->
                            <TextBlock Text="Condition"/>
                            <ComboBox SelectedItem="{Binding Condition}" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Near Mint"/>
                                <ComboBoxItem Content="Like New"/>
                                <ComboBoxItem Content="Very Good"/>
                                <ComboBoxItem Content="Good"/>
                                <ComboBoxItem Content="Acceptable"/>
                            </ComboBox>

                            <!-- Cost Basis -->
                            <TextBlock Text="Cost Basis" FontWeight="SemiBold" Margin="0,12,0,0"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Cost ($)"/>
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CostBasis}" Watermark="0.00"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Source"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding CostSource}" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="{x:Null}" Tag=""/>
                                    <ComboBoxItem Content="LCS"/>
                                    <ComboBoxItem Content="Online"/>
                                    <ComboBoxItem Content="CardShow"/>
                                    <ComboBoxItem Content="Break"/>
                                    <ComboBoxItem Content="Trade"/>
                                    <ComboBoxItem Content="Gift"/>
                                    <ComboBoxItem Content="PersonalCollection"/>
                                    <ComboBoxItem Content="Unknown"/>
                                </ComboBox>
                            </Grid>

                            <TextBlock Text="Notes"/>
                            <TextBox Text="{Binding Notes}" Watermark="Optional notes..." AcceptsReturn="True" MinHeight="50"/>
                        </StackPanel>
                    </Border>

                    <!-- Enhance ticker — shows live AI-enhance state with image, OCR text, and model -->
                    <Border IsVisible="{Binding IsEnhancing}"
                            Background="#FFF8E1" CornerRadius="6" Padding="14"
                            BorderBrush="#FFB300" BorderThickness="1">
                        <StackPanel Spacing="10" x:CompileBindings="False">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock FontWeight="SemiBold" FontSize="14">
                                        <Run Text="Enhancing card"/>
                                        <Run Text="{Binding EnhanceProgress}"/>
                                        <Run Text="of"/>
                                        <Run Text="{Binding EnhanceTotal}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentEnhanceItem.DisplayName}"
                                               FontSize="13" Opacity="0.85"/>
                                    <TextBlock FontSize="11" Opacity="0.7">
                                        <Run Text="Model:"/>
                                        <Run Text="{Binding CurrentEnhanceModel}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                  IsVisible="{Binding CurrentEnhanceItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <Image Grid.Column="0" Height="120" Stretch="Uniform"
                                       Source="{Binding CurrentEnhanceItem.FrontImagePath, Converter={StaticResource FilePathToBitmapConverter}}"/>
                                <Image Grid.Column="1" Height="120" Stretch="Uniform"
                                       Source="{Binding CurrentEnhanceItem.BackImagePath, Converter={StaticResource FilePathToBitmapConverter}}"/>
                            </Grid>

                            <StackPanel Spacing="4"
                                        IsVisible="{Binding CurrentEnhanceItem.CardDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <TextBlock Text="OCR-extracted hints sent to AI:" FontSize="11" FontWeight="SemiBold" Opacity="0.75"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="2">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Player:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.PlayerName}" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Year:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.Year}" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Card #:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.CardNumber}" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Manufacturer:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.Manufacturer}" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Brand:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.Brand}" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Set:" FontSize="11" Opacity="0.7"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentEnhanceItem.CardDetail.SetName}" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="2"
                                        IsVisible="{Binding CurrentEnhanceItem.OcrTextPreview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Raw OCR text:" FontSize="11" FontWeight="SemiBold" Opacity="0.75"/>
                                <Border Background="White" CornerRadius="3" Padding="6" MaxHeight="100">
                                    <ScrollViewer>
                                        <TextBlock Text="{Binding CurrentEnhanceItem.OcrTextPreview}"
                                                   FontFamily="Consolas, Courier New" FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Empty state when no item is selected or no items scanned -->
                    <StackPanel IsVisible="{Binding SelectedCard, Converter={x:Static ObjectConverters.IsNull}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="8" Margin="0,80,0,0">
                        <TextBlock Text="No card selected" FontSize="16" Opacity="0.5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Select images, scan them, then click a card to edit"
                                   Opacity="0.4" HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Button Row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="Scan All" Command="{Binding ScanAllCommand}"
                    Classes="accent" Padding="20,10"/>
            <Button Content="Cancel Scan" Command="{Binding CancelScanCommand}"
                    IsVisible="{Binding IsScanning}" Padding="20,10"/>
            <Button Content="Save All" Command="{Binding SaveAllCommand}"
                    IsEnabled="{Binding CanSave}"
                    ToolTip.Tip="Pick a Surprise Set to enable when destination is Surprise Set"
                    Padding="20,10"/>
            <Button Content="Rescan Selected" Command="{Binding RescanSelectedCommand}"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Padding="20,10"/>
            <!-- Enhance buttons (OCR mode). "Enhance All" runs every OCR-scanned
                 card; "Enhance Selected" runs only the rows the user checked
                 (HasSelectedOcrItems). Visibility is driven by VM-level computed
                 properties that auto-refresh when item state changes (the VM
                 subscribes to per-item PropertyChanged in its constructor). -->
            <Button Content="Enhance All with AI" Command="{Binding EnhanceAllCommand}"
                    IsVisible="{Binding HasOcrScannedItems}"
                    IsEnabled="{Binding !IsEnhancing}"
                    Padding="20,10"/>
            <Button Content="Enhance Selected" Command="{Binding EnhanceSelectedCommand}"
                    IsVisible="{Binding HasSelectedOcrItems}"
                    IsEnabled="{Binding !IsEnhancing}"
                    Padding="20,10"/>
            <!-- Enhance progress -->
            <StackPanel IsVisible="{Binding IsEnhancing}" Orientation="Horizontal"
                        Spacing="8" VerticalAlignment="Center">
                <ProgressBar Minimum="0" Maximum="{Binding EnhanceTotal}" Value="{Binding EnhanceProgress}"
                             Width="120" Height="8" VerticalAlignment="Center"/>
                <TextBlock FontSize="12" Opacity="0.8" VerticalAlignment="Center">
                    <Run Text="Enhancing"/>
                    <Run Text="{Binding EnhanceProgress}"/>
                    <Run Text="of"/>
                    <Run Text="{Binding EnhanceTotal}"/>
                </TextBlock>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <Button Content="Cancel Enhance" Command="{Binding CancelEnhanceCommand}"
                        Padding="10,4" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}"
                    Padding="20,10"/>
            <Button Content="Clear All" Command="{Binding ClearAllCommand}"
                    Padding="20,10"/>

            <!-- Messages -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="Green"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
    </Grid>
</UserControl>
