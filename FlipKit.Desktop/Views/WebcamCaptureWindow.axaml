<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlipKit.Desktop.ViewModels"
        xmlns:media="using:Avalonia.Media"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="640"
        x:Class="FlipKit.Desktop.Views.WebcamCaptureWindow"
        x:DataType="vm:WebcamCaptureViewModel"
        Width="820" Height="640"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Title="Capture from Webcam">

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,20" RowSpacing="10">

        <!-- Header / device picker -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Capture from Webcam" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Frame the card and click Capture. Use Retake to try again."
                           FontSize="11" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Camera:" VerticalAlignment="Center" FontSize="12"/>
                <ComboBox ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          MinWidth="160"
                          IsEnabled="{Binding !IsBusy}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Preview / captured-still surface -->
        <Border Grid.Row="1"
                Background="Black"
                CornerRadius="4"
                ClipToBounds="True">
            <Grid>
                <!-- Live preview image: bound code-behind copies frames into this WriteableBitmap -->
                <Image x:Name="PreviewImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding !HasCapturedImage}"/>

                <!-- Captured still preview. HighQuality interpolation matters here:
                     the captured JPG is typically smaller than the preview surface,
                     and the default (Low/Bilinear) makes it look blurry on upscale
                     even when the underlying file is sharp. -->
                <Image x:Name="CapturedImage"
                       Stretch="Uniform"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding HasCapturedImage}"/>

                <!-- Status overlay -->
                <Border Background="#80000000"
                        CornerRadius="4"
                        Padding="14,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2"
                Background="#FFEBEE"
                CornerRadius="4"
                Padding="12,8"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B71C1C" FontSize="12"/>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.5" FontSize="11"
                       Text="{Binding CapturedImagePath}"/>

            <Button Grid.Column="1" Content="Retake"
                    Command="{Binding RetakeCommand}"
                    IsVisible="{Binding HasCapturedImage}"
                    Padding="20,8" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="Capture"
                    Command="{Binding CaptureCommand}"
                    Classes="accent"
                    IsVisible="{Binding !HasCapturedImage}"
                    IsEnabled="{Binding IsPreviewing}"
                    Padding="24,8" Margin="0,0,8,0"/>

            <Button Grid.Column="2" Content="Use This"
                    Click="OnUseThisClick"
                    Classes="accent"
                    IsVisible="{Binding HasCapturedImage}"
                    Padding="24,8" Margin="0,0,8,0"/>

            <Button Grid.Column="3" Content="Cancel"
                    Click="OnCancelClick"
                    Padding="20,8"/>
        </Grid>
    </Grid>
</Window>
