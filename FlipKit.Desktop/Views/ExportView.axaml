<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipKit.Desktop.ViewModels"
             xmlns:export="using:FlipKit.Core.Services.Export"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="FlipKit.Desktop.Views.ExportView"
             x:DataType="vm:ExportViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,24,24,60">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Export to Whatnot or eBay" FontSize="24" FontWeight="Bold"/>
            <TextBlock Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap">
                Pick the cards you want to export, choose the platform, then download the CSV.
                Cards auto-promote to "Listed" after export but stay re-exportable any time.
            </TextBlock>
        </StackPanel>

        <!-- Filter bar -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">

                <!-- Status pills -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Status:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding ShowReady}" Content="Ready"/>
                    <CheckBox IsChecked="{Binding ShowListed}" Content="Listed"/>
                    <CheckBox IsChecked="{Binding ShowDraft}" Content="Draft"/>
                    <CheckBox IsChecked="{Binding ShowSold}" Content="Sold"/>
                </StackPanel>

                <!-- Sport + Date range + Search -->
                <Grid ColumnDefinitions="Auto,160,Auto,*,Auto,*,Auto,*,Auto" RowDefinitions="Auto"
                      ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Text="Sport:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SportFilterOptions}"
                              SelectedItem="{Binding SportFilter}" HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Column="2" Text="Added between:" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <DatePicker Grid.Column="3" SelectedDate="{Binding AddedFrom}"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock Grid.Column="4" Text="and" VerticalAlignment="Center"
                               Margin="4,0,4,0" Opacity="0.6"/>
                    <DatePicker Grid.Column="5" SelectedDate="{Binding AddedTo}"
                                HorizontalAlignment="Stretch"/>

                    <TextBlock Grid.Column="6" Text="Search:" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox Grid.Column="7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Watermark="Player, set, brand, card #, SKU"/>

                    <Button Grid.Column="8" Content="Reset" Command="{Binding ClearFiltersCommand}"
                            Padding="10,4" Margin="8,0,0,0" FontSize="11"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Card list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1" CornerRadius="8">
            <Grid RowDefinitions="*,Auto">

                <DataGrid Grid.Row="0" ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="False"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Width="40"
                                                Binding="{Binding IsSelected}"/>
                        <DataGridTextColumn Header="Player" Binding="{Binding PlayerName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Year"   Binding="{Binding Year}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Sport"  Binding="{Binding Sport}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Set"    Binding="{Binding Set}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price"  Binding="{Binding ListingPrice, StringFormat='\{0:C2\}'}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Added"  Binding="{Binding CreatedAt, StringFormat='\{0:yyyy-MM-dd\}'}" Width="100" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Selection bar (sits inside the card border for visual cohesion) -->
                <Border Grid.Row="1" BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="0,1,0,0" Padding="12,8"
                        Background="{DynamicResource SystemChromeLowColor}">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <Button Grid.Column="0" Content="Select all visible"
                                Command="{Binding SelectAllVisibleCommand}"
                                Padding="10,4" FontSize="11"/>
                        <Button Grid.Column="1" Content="Select none"
                                Command="{Binding SelectNoneCommand}"
                                Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
                        <Button Grid.Column="2" Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12">
                            <Run Text="{Binding SelectedCount}"/>
                            <Run Text="of"/>
                            <Run Text="{Binding VisibleCount}"/>
                            <Run Text="selected ·"/>
                            <Run Text="{Binding SelectedValue, StringFormat='\{0:C2\}'}" FontWeight="SemiBold"/>
                            <Run Text="value"/>
                        </TextBlock>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- Bottom: platform + export + messages + errors -->
        <StackPanel Grid.Row="3" Spacing="10" Margin="0,12,0,0">

            <Grid ColumnDefinitions="Auto,200,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Platform:" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ExportPlatformOptions}"
                          SelectedItem="{Binding SelectedExportPlatform}"
                          HorizontalAlignment="Stretch" Margin="6,0,0,0"/>
                <Button Grid.Column="2" Content="Download CSV for Selected"
                        Command="{Binding ExportCsvCommand}"
                        Classes="accent" Padding="16,8" Margin="12,0,0,0"/>
                <Button Grid.Column="3" Content="Open Whatnot Seller Hub"
                        Command="{Binding OpenWhatnotSellerHubCommand}"
                        Padding="12,6" Margin="8,0,0,0" FontSize="11"/>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontSize="13"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Per-row validation errors (populated when an export is blocked) -->
            <Border IsVisible="{Binding HasRowErrors}"
                    BorderBrush="#E53935" BorderThickness="1"
                    Background="#1FE53935" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Validation issues" FontWeight="SemiBold" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding RowErrors}" MaxHeight="180">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="export:ExportRowError">
                                <Grid ColumnDefinitions="60,160,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Severity}"
                                               FontSize="10" FontWeight="Bold" Opacity="0.8"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayerName}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.85"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Field}" FontWeight="SemiBold"/>
                                        <Run Text=":"/>
                                        <Run Text="{Binding Message}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
