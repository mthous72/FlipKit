<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlipKit.Desktop.ViewModels"
             xmlns:export="using:FlipKit.Core.Services.Export"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="FlipKit.Desktop.Views.ExportView"
             x:DataType="vm:ExportViewModel">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="20" MaxWidth="700">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Export to Whatnot" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Generate CSV for Whatnot or eBay bulk import" Opacity="0.6"/>
                </StackPanel>

                <!-- Help Button -->
                <Button Grid.Column="1" Width="32" Height="32" Padding="0" VerticalAlignment="Top"
                        ToolTip.Tip="Quick Help">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border MaxWidth="350" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="📤 Export - Quick Guide" FontSize="16" FontWeight="Bold"/>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="1️⃣ Save cards with images and prices" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                                            • A card with both becomes "Ready" automatically
                                            <LineBreak/>
                                            • Images upload to ImgBB at save time — no separate step
                                            <LineBreak/>
                                            • Drafts (missing price or images) can be completed later
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="2️⃣ Generate CSV" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                                            • Pick the platform (Whatnot or eBay)
                                            <LineBreak/>
                                            • Includes all Ready and Listed cards
                                            <LineBreak/>
                                            • Validation errors surface inline if any
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="3️⃣ Import to the marketplace" FontWeight="SemiBold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                                            • Whatnot: Seller Hub → Inventory → Import Products
                                            <LineBreak/>
                                            • eBay: Seller Hub → Reports → Upload File
                                            <LineBreak/>
                                            • Use VerifyAdd dry-run for eBay first
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Background="{DynamicResource SystemChromeLowColor}"
                                            CornerRadius="4" Padding="8" Margin="0,8,0,0">
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7">
                                            💡 <Run FontWeight="Bold">Tip:</Run> Cards auto-promote to Ready when you save them with both images and a price. No separate upload step needed.
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <TextBlock Text="?" FontSize="18" FontWeight="Bold"/>
                </Button>
            </Grid>

            <!-- Summary Cards -->
            <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Export Summary" FontSize="18" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cards ready for export:"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReadyCardCount}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Drafts (need price or images):"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NeedsPricingCount}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Total value:"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalValue, StringFormat='\{0:C2\}'}" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6">
                        Cards are marked Ready automatically when they're saved with both images and a listing price.
                        Drafts can be completed by editing the card.
                    </TextBlock>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="12,6" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Download CSV -->
            <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Download CSV" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Generate CSV file with optimized listing titles" Opacity="0.6"/>

                    <!-- Export Platform Selector -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Export Platform" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ExportPlatformOptions}"
                                  SelectedItem="{Binding SelectedExportPlatform}"
                                  HorizontalAlignment="Stretch"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6">
                            <Run Text="Titles will be formatted using the"/>
                            <Run Text="{Binding SelectedExportPlatform}" FontWeight="SemiBold"/>
                            <Run Text="template. Different platforms use different SEO strategies:"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.5" Margin="0,-4,0,0">
                            • Whatnot: Brand + Player focus (e.g., "Prizm CJ Stroud")
                            • eBay: Comprehensive with manufacturer emphasis
                            • COMC: Consignment format without manufacturer
                            • Generic: Balanced approach
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.5" Margin="0,4,0,0">
                            Tip: Customize templates in Settings for each platform.
                        </TextBlock>
                    </StackPanel>

                    <Button Content="Download CSV for Export" Command="{Binding ExportCsvCommand}"
                            Classes="accent" Padding="20,10"/>
                </StackPanel>
            </Border>

            <!-- Import to Whatnot -->
            <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Import to Whatnot" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.6"
                               Text="Go to Whatnot Seller Hub > Inventory > Import Products. Upload the CSV file, review drafts, then publish."/>
                    <Button Content="Open Whatnot Seller Hub" Command="{Binding OpenWhatnotSellerHubCommand}" Padding="16,8"/>
                </StackPanel>
            </Border>

            <!-- Messages -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="Green" FontSize="14"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" FontSize="14" TextWrapping="Wrap"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Per-row validation errors (populated when an export is blocked) -->
            <Border IsVisible="{Binding HasRowErrors}"
                    BorderBrush="#E53935" BorderThickness="1"
                    Background="#1FE53935" CornerRadius="6" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Validation issues" FontWeight="SemiBold" FontSize="13"/>
                    <ItemsControl ItemsSource="{Binding RowErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="export:ExportRowError">
                                <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Severity}"
                                               FontSize="10" FontWeight="Bold"
                                               Width="60" VerticalAlignment="Top" Opacity="0.8"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PlayerName}"
                                               FontWeight="SemiBold" FontSize="12"
                                               Margin="0,0,8,0" Width="160"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" FontSize="12" Opacity="0.85"
                                               TextWrapping="Wrap">
                                        <Run Text="{Binding Field}" FontWeight="SemiBold"/>
                                        <Run Text=":"/>
                                        <Run Text="{Binding Message}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
