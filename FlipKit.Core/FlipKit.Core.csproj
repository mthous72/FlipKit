<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.11" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.1.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whatnot reference data + eBay template header, embedded so all consumers
         (Desktop, Web, Api) get the same source of truth without ship-time path lookups. -->
    <EmbeddedResource Include="Resources\Export\whatnot_values.json" />
    <EmbeddedResource Include="Resources\Export\ebay_template_header.csv" />
    <!-- Bundled parallel families per (Year, Brand, Sport) — factual published data,
         same legal posture as KnownSetsCatalog. Drives the Parallel dropdown in the
         Phase 2 tier-aware editor. Sets not in the catalog show free-text Parallel. -->
    <EmbeddedResource Include="Resources\ParallelFamilyCatalog.json" />
    <!-- Bootstrap reference data — teams (with sport mapping), manufacturers, brands.
         Stable, low-variance facts shipped with the app so OCR scanning works
         out-of-the-box before any checklists are imported. Updates to leagues
         (relocations, expansions) are JSON edits, never code changes. -->
    <EmbeddedResource Include="Resources\ReferenceData\leagues_teams.json" />
    <EmbeddedResource Include="Resources\ReferenceData\manufacturers.json" />
    <EmbeddedResource Include="Resources\ReferenceData\brands.json" />
    <EmbeddedResource Include="Resources\ReferenceData\parallels.json" />
    <EmbeddedResource Include="Resources\ReferenceData\grading_authorities.json" />
    <EmbeddedResource Include="Resources\ReferenceData\league_acronyms.json" />
  </ItemGroup>

</Project>
