@model FlipKit.Web.Models.InventoryListViewModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5"><i class="bi bi-list-ul"></i> Inventory</h1>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="ImportEbay" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-cloud-upload"></i> Import eBay…
            </a>
            <span class="badge bg-primary fs-6">@Model.TotalCount Cards</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="search" class="form-label">Search</label>
                    <input type="text" class="form-control" id="search" name="search"
                           value="@Model.SearchQuery" placeholder="Player, team, brand...">
                </div>
                <div class="col-md-3">
                    <label for="sport" class="form-label">Sport</label>
                    <select class="form-select" id="sport" name="sport">
                        <option value="All" selected="@(Model.SelectedSport == "All")">All Sports</option>
                        <option value="Football" selected="@(Model.SelectedSport == "Football")">Football</option>
                        <option value="Baseball" selected="@(Model.SelectedSport == "Baseball")">Baseball</option>
                        <option value="Basketball" selected="@(Model.SelectedSport == "Basketball")">Basketball</option>
                        <option value="Hockey" selected="@(Model.SelectedSport == "Hockey")">Hockey</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" id="status" name="status">
                        <option value="All" selected="@(Model.SelectedStatus == "All")">All Status</option>
                        <option value="Draft" selected="@(Model.SelectedStatus == "Draft")">Draft</option>
                        <option value="Priced" selected="@(Model.SelectedStatus == "Priced")">Priced</option>
                        <option value="Ready" selected="@(Model.SelectedStatus == "Ready")">Ready</option>
                        <option value="Listed" selected="@(Model.SelectedStatus == "Listed")">Listed</option>
                        <option value="Sold" selected="@(Model.SelectedStatus == "Sold")">Sold</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Cards Table -->
    @if (Model.Cards.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Player</th>
                                <th>Sport</th>
                                <th>Year</th>
                                <th>Brand</th>
                                <th>Card #</th>
                                <th>Status</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var card in Model.Cards)
                            {
                                <tr>
                                    <td>
                                        <strong>@card.PlayerName</strong>
                                        @if (card.IsRookie)
                                        {
                                            <span class="badge bg-warning text-dark">RC</span>
                                        }
                                        @if (card.IsAuto)
                                        {
                                            <span class="badge bg-info">Auto</span>
                                        }
                                        @if (card.IsGraded)
                                        {
                                            <span class="badge bg-success">@card.GradeCompany @card.GradeValue</span>
                                        }
                                    </td>
                                    <td>@card.Sport</td>
                                    <td>@card.Year</td>
                                    <td>@card.Brand</td>
                                    <td>@card.CardNumber</td>
                                    <td>
                                        @switch (card.Status.ToString())
                                        {
                                            case "Draft":
                                                <span class="badge bg-secondary">Draft</span>
                                                break;
                                            case "Priced":
                                                <span class="badge bg-primary">Priced</span>
                                                break;
                                            case "Ready":
                                                <span class="badge bg-success">Ready</span>
                                                break;
                                            case "Listed":
                                                <span class="badge bg-info">Listed</span>
                                                break;
                                            case "Sold":
                                                <span class="badge bg-dark">Sold</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (card.ListingPrice.HasValue)
                                        {
                                            <text>$@card.ListingPrice.Value.ToString("N2")</text>
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@card.Id"
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@card.Id"
                                               class="btn btn-outline-secondary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (card.Status == FlipKit.Core.Models.Enums.CardStatus.Priced ||
                                                 card.Status == FlipKit.Core.Models.Enums.CardStatus.Ready ||
                                                 card.Status == FlipKit.Core.Models.Enums.CardStatus.Listed)
                                            {
                                                <button type="button" class="btn btn-outline-success"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#markAsSoldModal"
                                                        data-card-id="@card.Id"
                                                        data-card-name="@card.PlayerName"
                                                        data-listing-price="@(card.ListingPrice?.ToString("F2") ?? "")"
                                                        title="Mark as Sold">
                                                    <i class="bi bi-currency-dollar"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-warning"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#repriceModal@(card.Id)"
                                                        title="Reprice">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal@(card.Id)"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>

                                        <!-- Reprice Confirmation Modal -->
                                        @if (card.Status == FlipKit.Core.Models.Enums.CardStatus.Priced ||
                                             card.Status == FlipKit.Core.Models.Enums.CardStatus.Ready ||
                                             card.Status == FlipKit.Core.Models.Enums.CardStatus.Listed)
                                        {
                                            <div class="modal fade" id="repriceModal@(card.Id)" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Reprice Card</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Clear pricing for <strong>@card.PlayerName</strong> and send back to Draft?
                                                            This will clear the listing price and market value.
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-action="Reprice" asp-route-id="@card.Id" method="post" style="display:inline;">
                                                                @Html.AntiForgeryToken()
                                                                <button type="submit" class="btn btn-warning">Reprice</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        <!-- Delete Confirmation Modal -->
                                        <div class="modal fade" id="deleteModal@(card.Id)" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title">Confirm Delete</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Are you sure you want to delete <strong>@card.PlayerName</strong>?
                                                        This cannot be undone.
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <form asp-action="Delete" asp-route-id="@card.Id" method="post" style="display:inline;">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Delete</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Inventory pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-sport="@Model.SelectedSport"
                                   asp-route-status="@Model.SelectedStatus">
                                    Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-search="@Model.SearchQuery"
                                       asp-route-sport="@Model.SelectedSport"
                                       asp-route-status="@Model.SelectedStatus">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-search="@Model.SearchQuery"
                                   asp-route-sport="@Model.SelectedSport"
                                   asp-route-status="@Model.SelectedStatus">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4><i class="bi bi-info-circle"></i> No cards found</h4>
            <p>Try adjusting your filters or <a asp-controller="Scan" asp-action="Index">scan a new card</a>.</p>
        </div>
    }
</div>

<!-- Mark as Sold — single shared modal, populated by JS from button data attributes -->
<div class="modal fade" id="markAsSoldModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-currency-dollar"></i> Mark as Sold</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="MarkAsSold" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="soldCardId" name="id" value="">
                <div class="modal-body">
                    <p class="fw-bold mb-3" id="soldCardName"></p>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label">Sale Price <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="soldSalePrice" name="salePrice"
                                       step="0.01" min="0" required oninput="recalcNet()">
                            </div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Sale Date</label>
                            <input type="date" class="form-control" id="soldSaleDate" name="saleDate" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Platform</label>
                            <select class="form-select" id="soldPlatform" name="salePlatform" onchange="recalcNet()">
                                <option value="Whatnot">Whatnot</option>
                                <option value="eBay">eBay</option>
                                <option value="COMC">COMC</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Fees Paid</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="soldFees" name="feesPaid"
                                       step="0.01" min="0" placeholder="auto" oninput="recalcNet()">
                            </div>
                            <div class="form-text">Leave blank to auto-calculate (11%)</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Shipping Cost</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="soldShipping" name="shippingCost"
                                       step="0.01" min="0" value="1.00" oninput="recalcNet()">
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-2 bg-light rounded d-flex justify-content-between align-items-center">
                                <span class="text-muted">Estimated Net Profit:</span>
                                <span id="soldNetProfit" class="fw-bold fs-5 text-success"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> Mark as Sold
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const soldModal = document.getElementById('markAsSoldModal');
    soldModal.addEventListener('show.bs.modal', function (event) {
        const btn = event.relatedTarget;
        document.getElementById('soldCardId').value = btn.dataset.cardId;
        document.getElementById('soldCardName').textContent = btn.dataset.cardName;

        const price = parseFloat(btn.dataset.listingPrice) || 0;
        document.getElementById('soldSalePrice').value = price > 0 ? price.toFixed(2) : '';
        document.getElementById('soldSaleDate').value = new Date().toISOString().slice(0, 10);
        document.getElementById('soldPlatform').value = 'Whatnot';
        document.getElementById('soldFees').value = '';
        document.getElementById('soldShipping').value = '1.00';
        recalcNet();
    });

    function recalcNet() {
        const price = parseFloat(document.getElementById('soldSalePrice').value) || 0;
        const feesInput = document.getElementById('soldFees').value;
        const fees = feesInput !== '' ? parseFloat(feesInput) : price * 0.11;
        const shipping = parseFloat(document.getElementById('soldShipping').value) || 0;
        const net = price - fees - shipping;
        const el = document.getElementById('soldNetProfit');
        el.textContent = '$' + net.toFixed(2);
        el.className = 'fw-bold fs-5 ' + (net >= 0 ? 'text-success' : 'text-danger');
    }
</script>
