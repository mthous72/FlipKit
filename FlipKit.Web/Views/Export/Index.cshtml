@model FlipKit.Web.Models.ExportListViewModel
@{
    ViewData["Title"] = "Export to CSV";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5"><i class="bi bi-file-earmark-spreadsheet"></i> Export to CSV</h1>
        <span class="badge bg-primary fs-6">@Model.Cards.Count Cards</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.ValidationErrors.Any())
    {
        <div class="alert alert-danger">
            <h5><i class="bi bi-exclamation-triangle"></i> Export blocked — fix these errors first:</h5>
            <ul class="mb-0">
                @foreach (var err in Model.ValidationErrors)
                {
                    <li><strong>@err.PlayerName</strong> — @err.Field: @err.Message</li>
                }
            </ul>
        </div>
    }
    @if (Model.ValidationWarnings.Any())
    {
        <div class="alert alert-warning">
            <h5><i class="bi bi-exclamation-circle"></i> Warnings (export will proceed):</h5>
            <ul class="mb-0">
                @foreach (var warn in Model.ValidationWarnings)
                {
                    <li><strong>@warn.PlayerName</strong> — @warn.Field: @warn.Message</li>
                }
            </ul>
        </div>
    }

    <!-- Filter + Export Form -->
    <form asp-action="ExportCsv" method="post" id="exportForm">
        @Html.AntiForgeryToken()

        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label for="search" class="form-label">Search</label>
                        <input type="text" class="form-control" id="search" name="search"
                               value="@Model.SearchQuery" placeholder="Player, brand, set...">
                    </div>
                    <div class="col-md-2">
                        <label for="sport" class="form-label">Sport</label>
                        <select class="form-select" id="sport" name="sport">
                            <option value="All" selected="@(Model.SelectedSport == "All")">All Sports</option>
                            <option value="Football" selected="@(Model.SelectedSport == "Football")">Football</option>
                            <option value="Baseball" selected="@(Model.SelectedSport == "Baseball")">Baseball</option>
                            <option value="Basketball" selected="@(Model.SelectedSport == "Basketball")">Basketball</option>
                            <option value="Hockey" selected="@(Model.SelectedSport == "Hockey")">Hockey</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="status" class="form-label">Status</label>
                        <select class="form-select" id="status" name="status">
                            <option value="All" selected="@(Model.SelectedStatus == "All")">All Status</option>
                            <option value="Priced" selected="@(Model.SelectedStatus == "Priced")">Priced</option>
                            <option value="Ready" selected="@(Model.SelectedStatus == "Ready")">Ready</option>
                            <option value="Listed" selected="@(Model.SelectedStatus == "Listed")">Listed</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label for="platform" class="form-label">Platform</label>
                        <select class="form-select" id="platform" name="platform">
                            <option value="Whatnot" selected="@(Model.SelectedPlatform == "Whatnot")">Whatnot</option>
                            <option value="Ebay" selected="@(Model.SelectedPlatform == "Ebay")">eBay</option>
                            <option value="Generic" selected="@(Model.SelectedPlatform == "Generic")">Generic</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <a asp-action="Index"
                           asp-route-search="@Model.SearchQuery"
                           asp-route-sport="@Model.SelectedSport"
                           asp-route-status="@Model.SelectedStatus"
                           asp-route-platform="@Model.SelectedPlatform"
                           class="btn btn-outline-secondary w-100">
                            <i class="bi bi-search"></i>
                        </a>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllBtn" onclick="toggleAll(true)">All</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleAll(false)">None</button>
                        <button type="submit" class="btn btn-success flex-grow-1" id="exportBtn">
                            <i class="bi bi-download"></i> Export
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cards Table -->
        @if (Model.Cards.Any())
        {
            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:40px;">
                                        <input type="checkbox" id="checkAll" class="form-check-input" checked
                                               onchange="document.querySelectorAll('.card-check').forEach(c=>c.checked=this.checked)">
                                    </th>
                                    <th>Player</th>
                                    <th>Sport</th>
                                    <th>Year</th>
                                    <th>Brand / Set</th>
                                    <th>Card #</th>
                                    <th>Status</th>
                                    <th class="text-end">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in Model.Cards)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="selectedIds" value="@card.Id"
                                                   class="form-check-input card-check" checked>
                                        </td>
                                        <td>
                                            <strong>@card.PlayerName</strong>
                                            @if (card.IsRookie) { <span class="badge bg-warning text-dark">RC</span> }
                                            @if (card.IsAuto) { <span class="badge bg-info text-dark">Auto</span> }
                                            @if (card.IsGraded) { <span class="badge bg-success">@card.GradeCompany @card.GradeValue</span> }
                                        </td>
                                        <td>@card.Sport</td>
                                        <td>@(card.Year?.ToString() ?? "-")</td>
                                        <td>
                                            @(card.Brand ?? "-")
                                            @if (!string.IsNullOrEmpty(card.SetName))
                                            {
                                                <br><small class="text-muted">@card.SetName</small>
                                            }
                                        </td>
                                        <td>@(card.CardNumber ?? "-")</td>
                                        <td>
                                            @switch (card.Status.ToString())
                                            {
                                                case "Priced": <span class="badge bg-primary">Priced</span> break;
                                                case "Ready": <span class="badge bg-success">Ready</span> break;
                                                case "Listed": <span class="badge bg-info text-dark">Listed</span> break;
                                                default: <span class="badge bg-secondary">@card.Status</span> break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (card.ListingPrice.HasValue)
                                            {
                                                <span class="text-success fw-bold">$@card.ListingPrice.Value.ToString("N2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">No price</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <h4><i class="bi bi-info-circle"></i> No cards match your filters</h4>
                <p>Try changing the status filter or <a asp-controller="Inventory" asp-action="Index">view your inventory</a>.</p>
            </div>
        }
    </form>
</div>

<script>
function toggleAll(checked) {
    document.querySelectorAll('.card-check').forEach(c => c.checked = checked);
    document.getElementById('checkAll').checked = checked;
}
</script>
