@model FlipKit.Web.Models.SurpriseSetIndexViewModel
@{
    ViewData["Title"] = "Surprise Sets";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0"><i class="bi bi-gift"></i> Surprise Sets</h2>
            <p class="text-muted small mb-0">Create and manage Whatnot Surprise Set listings</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Set
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Sets.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-gift display-4"></i>
            <p class="mt-3">No Surprise Sets yet. Create one to get started.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Show Name</th>
                        <th>State</th>
                        <th>Cards</th>
                        <th>Spot Price</th>
                        <th>Condition</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var set in Model.Sets)
                    {
                        <tr>
                            <td class="fw-semibold">@set.Name</td>
                            <td class="text-muted">@set.ShowName</td>
                            <td>
                                @{
                                    var badgeClass = set.State.ToString() switch
                                    {
                                        "Draft"     => "bg-secondary",
                                        "Exported"  => "bg-info text-dark",
                                        "Live"      => "bg-success",
                                        "Completed" => "bg-primary",
                                        "Cancelled" => "bg-danger",
                                        _           => "bg-secondary",
                                    };
                                }
                                <span class="badge @badgeClass">@set.State</span>
                            </td>
                            <td>@set.Cards.Count</td>
                            <td>@set.SpotPrice.ToString("C")</td>
                            <td>@set.SharedCondition</td>
                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@set.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye"></i> View
                                </a>
                                @if (set.State == FlipKit.Core.Models.Enums.SurpriseSetState.Draft)
                                {
                                    <a asp-action="BulkScan" asp-route-id="@set.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-camera"></i> Scan
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
