@model FlipKit.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    var isEditable = Model.IsDockerEnvironment;
}

<div class="container py-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="mb-4">
                <i class="bi bi-gear"></i> Settings
                @if (!isEditable)
                {
                    <span class="badge bg-secondary ms-2">Read-Only</span>
                }
                else
                {
                    <span class="badge bg-success ms-2">Docker Mode</span>
                }
            </h2>

            @if (!isEditable)
            {
                <!-- Info Alert for Non-Docker Mode -->
                <div class="alert alert-info mb-4">
                    <h5 class="alert-heading">
                        <i class="bi bi-info-circle"></i> Settings Are Read-Only in Web App
                    </h5>
                    <p class="mb-2">
                        The Web application can <strong>view</strong> settings but cannot edit them when running alongside Desktop.
                    </p>
                    <hr>
                    <p class="mb-0">
                        <i class="bi bi-desktop"></i> <strong>To change settings:</strong> Open the <strong>FlipKit Desktop application</strong> and go to Settings.
                    </p>
                </div>
            }
            else
            {
                <!-- Docker Mode Info -->
                <div class="alert alert-success mb-4">
                    <h5 class="alert-heading">
                        <i class="bi bi-box"></i> Docker Configuration Mode
                    </h5>
                    <p class="mb-0">
                        You're running FlipKit in Docker. Configure your API keys and settings below. Settings are persisted to the mounted volume.
                    </p>
                </div>
            }

            <form asp-action="Save" method="post">
                @Html.AntiForgeryToken()

                <!-- API Keys -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-key"></i> API Keys
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- OpenRouter API Key -->
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="OpenRouterApiKey" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input type="password" asp-for="OpenRouterApiKey" class="form-control"
                                               placeholder="@(Model.HasOpenRouterKey ? "Enter new key to update" : "sk-or-...")">
                                        <button type="button" class="btn btn-outline-secondary toggle-password" title="Show/Hide">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <span class="input-group-text">
                                            @if (Model.HasOpenRouterKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Required for AI card scanning. <a href="https://openrouter.ai/keys" target="_blank">Get a free key</a></small>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                               value="@(Model.HasOpenRouterKey ? "••••••••••••••••••••" : "Not configured")"
                                               readonly>
                                        <span class="input-group-text">
                                            @if (Model.HasOpenRouterKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-danger"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Required for AI card scanning</small>
                                }
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                @if (Model.HasOpenRouterKey)
                                {
                                    <button type="button" class="btn btn-outline-primary w-100 test-connection-btn" data-service="openrouter">
                                        <i class="bi bi-lightning"></i> Test Connection
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- ImgBB API Key -->
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="ImgBBApiKey" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input type="password" asp-for="ImgBBApiKey" class="form-control"
                                               placeholder="@(Model.HasImgBBKey ? "Enter new key to update" : "Optional")">
                                        <button type="button" class="btn btn-outline-secondary toggle-password" title="Show/Hide">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <span class="input-group-text">
                                            @if (Model.HasImgBBKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Optional - for image uploads. <a href="https://api.imgbb.com/" target="_blank">Get a key</a></small>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                               value="@(Model.HasImgBBKey ? "••••••••••••••••••••" : "Not configured")"
                                               readonly>
                                        <span class="input-group-text">
                                            @if (Model.HasImgBBKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Optional - for image uploads</small>
                                }
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                @if (Model.HasImgBBKey)
                                {
                                    <button type="button" class="btn btn-outline-primary w-100 test-connection-btn" data-service="imgbb">
                                        <i class="bi bi-lightning"></i> Test Connection
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- CardSight API Key -->
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label asp-for="CardsightApiKey" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input type="password" asp-for="CardsightApiKey" class="form-control"
                                               placeholder="@(Model.HasCardsightKey ? "Enter new key to update" : "Optional — runs before OpenRouter")">
                                        <button type="button" class="btn btn-outline-secondary toggle-password" title="Show/Hide">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <span class="input-group-text">
                                            @if (Model.HasCardsightKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">
                                        Optional — sports-card recognition via CardSight (<strong>750 free identifications/month</strong>).
                                        Tried <em>before</em> OpenRouter; on miss or low confidence, FlipKit falls back to OpenRouter automatically.
                                        Sign up at <a href="https://cardsight.ai/" target="_blank">cardsight.ai</a>, then grab your key from the dashboard
                                        (see the <a href="https://api.cardsight.ai/documentation" target="_blank">API docs</a> for reference).
                                    </small>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                               value="@(Model.HasCardsightKey ? "••••••••••••••••••••" : "Not configured")"
                                               readonly>
                                        <span class="input-group-text">
                                            @if (Model.HasCardsightKey)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Optional — sports-card recognition via CardSight (750 free/month)</small>
                                }
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                @if (Model.HasCardsightKey)
                                {
                                    <button type="button" class="btn btn-outline-primary w-100 test-connection-btn" data-service="cardsight">
                                        <i class="bi bi-lightning"></i> Test Connection
                                    </button>
                                }
                            </div>
                        </div>

                        <!-- eBay API Credentials -->
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold">eBay Client ID</label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input type="password" asp-for="EbayClientId" class="form-control"
                                               placeholder="@(Model.HasEbayCredentials ? "Enter new Client ID to update" : "Your eBay App ID (Client ID)")">
                                        <button type="button" class="btn btn-outline-secondary toggle-password" title="Show/Hide">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <span class="input-group-text">
                                            @if (Model.HasEbayCredentials)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                               value="@(Model.HasEbayCredentials ? "••••••••••••••••••••" : "Not configured")"
                                               readonly>
                                        <span class="input-group-text">
                                            @if (Model.HasEbayCredentials)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label class="form-label fw-bold">eBay Client Secret</label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input type="password" asp-for="EbayClientSecret" class="form-control"
                                               placeholder="@(Model.HasEbayCredentials ? "Enter new Client Secret to update" : "Your eBay Client Secret")">
                                        <button type="button" class="btn btn-outline-secondary toggle-password" title="Show/Hide">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <span class="input-group-text">
                                            @if (Model.HasEbayCredentials)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Required for eBay listing creation. <a href="https://developer.ebay.com/my/keys" target="_blank">Get credentials</a></small>
                                }
                                else
                                {
                                    <div class="input-group">
                                        <input type="text" class="form-control"
                                               value="@(Model.HasEbayCredentials ? "••••••••••••••••••••" : "Not configured")"
                                               readonly>
                                        <span class="input-group-text">
                                            @if (Model.HasEbayCredentials)
                                            {
                                                <i class="bi bi-check-circle-fill text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-circle-fill text-warning"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">Required for eBay listing creation</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* OpenRouter Usage — server-rendered card. Shown only when an
                   API key is configured; renders error state inline when the
                   key-info fetch fails. Refresh button POSTs back to Index. *@
                @if (Model.HasOpenRouterKey)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-graph-up"></i> OpenRouter Usage
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.OpenRouterUsage is { } u)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="badge @(u.IsFreeTier ? "bg-secondary" : "bg-success")">
                                        @(u.IsFreeTier ? "Free tier" : "Paid")
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(u.Label))
                                    {
                                        <small class="text-muted">@u.Label</small>
                                    }
                                    <small class="text-muted ms-auto">
                                        Refreshed @u.FetchedAt.LocalDateTime.ToString("g")
                                    </small>
                                </div>

                                <div class="row g-2 mb-3">
                                    <div class="col-md-3">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">Credits remaining</div>
                                            <div class="fw-semibold">
                                                @if (u.LimitRemaining is { } rem && u.Limit is { } lim)
                                                {
                                                    @($"${rem:F2} of ${lim:F2}")
                                                }
                                                else if (u.LimitRemaining is { } rem2)
                                                {
                                                    @($"${rem2:F2}")
                                                }
                                                else
                                                {
                                                    <text>(no credit limit)</text>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">Today</div>
                                            <div class="fw-semibold">@($"${u.UsageDaily:F2}")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">This week</div>
                                            <div class="fw-semibold">@($"${u.UsageWeekly:F2}")</div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">This month</div>
                                            <div class="fw-semibold">@($"${u.UsageMonthly:F2}")</div>
                                        </div>
                                    </div>
                                </div>

                                @if (u.IsFreeTier)
                                {
                                    <div class="alert alert-warning small mb-0">
                                        Free models are limited to ~50 requests/day until you purchase ≥$10 of credits, which raises the cap to 1000/day.
                                        See <a href="https://openrouter.ai/credits" target="_blank">openrouter.ai/credits</a>.
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.OpenRouterUsageError))
                            {
                                <div class="alert alert-danger small mb-0">@Model.OpenRouterUsageError</div>
                            }

                            <form asp-action="RefreshUsage" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-arrow-clockwise"></i> Refresh
                                </button>
                            </form>
                        </div>
                    </div>
                }

                @* CardSight Usage — server-rendered card. Shown only when a
                   CardSight key is configured; renders error state inline when
                   the subscription fetch fails. CardSight reports an aggregate
                   call count but no plan limit, so usage is framed against the
                   documented free-tier allowance (750/mo), clearly labelled.
                   Refresh button POSTs back to Index. *@
                @if (Model.HasCardsightKey)
                {
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-card-image"></i> CardSight Usage
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (Model.CardsightUsage is { } cs)
                            {
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span class="badge bg-secondary">Free tier</span>
                                    <small class="text-muted ms-auto">
                                        Refreshed @cs.FetchedAt.LocalDateTime.ToString("g")
                                    </small>
                                </div>

                                <div class="row g-2 mb-2">
                                    <div class="col-md-6">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">Calls used this period</div>
                                            <div class="fw-semibold">@cs.CallsUsed</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="border rounded p-2">
                                            <div class="text-muted small">Free tier remaining</div>
                                            <div class="fw-semibold">@cs.CallsRemaining of @cs.FreeTierMonthlyQuota</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>Free tier: @cs.CallsUsed / @cs.FreeTierMonthlyQuota used · @cs.CallsRemaining remaining</span>
                                    </div>
                                    <div class="progress" role="progressbar" aria-valuenow="@cs.CallsUsed" aria-valuemin="0" aria-valuemax="@cs.FreeTierMonthlyQuota">
                                        <div class="progress-bar bg-info" style="width: @(cs.FreeTierMonthlyQuota > 0 ? Math.Min(100, (int)Math.Round(100.0 * cs.CallsUsed / cs.FreeTierMonthlyQuota)) : 0)%"></div>
                                    </div>
                                </div>

                                <div class="alert alert-secondary small mb-0">
                                    CardSight reports total calls but not your plan limit. The bar is scaled to the free tier of 750 identifications/month — if you're on a paid plan your actual cap is higher.
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.CardsightUsageError))
                            {
                                <div class="alert alert-danger small mb-0">@Model.CardsightUsageError</div>
                            }

                            <form asp-action="RefreshUsage" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-arrow-clockwise"></i> Refresh
                                </button>
                            </form>
                        </div>
                    </div>
                }

                <!-- AI Settings -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-robot"></i> AI Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="DefaultModel" class="form-label fw-bold"></label>
                            @if (isEditable)
                            {
                                <select asp-for="DefaultModel" class="form-select">
                                    <optgroup label="Recommended">
                                        <option value="@FlipKit.Web.Models.WebModelOption.AutoValue"
                                                selected="@(Model.DefaultModel == FlipKit.Web.Models.WebModelOption.AutoValue)">
                                            @FlipKit.Web.Models.WebModelOption.AutoLabel
                                        </option>
                                    </optgroup>
                                    @if (Model.FreeModels.Count > 0)
                                    {
                                        <optgroup label="Free Models">
                                            @foreach (var m in Model.FreeModels)
                                            {
                                                <option value="@m.Id" selected="@(m.Id == Model.DefaultModel)">
                                                    @FlipKit.Core.Services.Scanning.ModelCostFormatter.FormatDropdownLabel(m)
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                    @if (Model.PaidModels.Count > 0)
                                    {
                                        <optgroup label="Paid Models (cheapest first)">
                                            @foreach (var m in Model.PaidModels)
                                            {
                                                <option value="@m.Id" selected="@(m.Id == Model.DefaultModel)">
                                                    @FlipKit.Core.Services.Scanning.ModelCostFormatter.FormatDropdownLabel(m)
                                                </option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(Model.CatalogError))
                                {
                                    <small class="text-warning d-block mt-1">
                                        <i class="bi bi-exclamation-triangle"></i> @Model.CatalogError
                                    </small>
                                }
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Model.DefaultModel" readonly>
                            }
                            <small class="text-muted">Model used for card scanning</small>
                        </div>
                        @if (isEditable)
                        {
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input asp-for="EnableVariationVerification" class="form-check-input" type="checkbox">
                                        <label asp-for="EnableVariationVerification" class="form-check-label"></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input asp-for="AutoApplyHighConfidenceSuggestions" class="form-check-input" type="checkbox">
                                        <label asp-for="AutoApplyHighConfidenceSuggestions" class="form-check-label"></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-check form-switch">
                                        <input asp-for="EnableChecklistLearning" class="form-check-input" type="checkbox">
                                        <label asp-for="EnableChecklistLearning" class="form-check-label"></label>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Fee Settings -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-percent"></i> Fee Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label asp-for="WhatnotFeePercent" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input asp-for="WhatnotFeePercent" type="number" step="0.01" class="form-control">
                                        <span class="input-group-text">%</span>
                                    </div>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.WhatnotFeePercent%" readonly>
                                }
                            </div>
                            <div class="col-md-3">
                                <label asp-for="EbayFeePercent" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input asp-for="EbayFeePercent" type="number" step="0.01" class="form-control">
                                        <span class="input-group-text">%</span>
                                    </div>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.EbayFeePercent%" readonly>
                                }
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DefaultShippingCostPwe" class="form-label fw-bold">Shipping (PWE)</label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="DefaultShippingCostPwe" type="number" step="0.01" class="form-control">
                                    </div>
                                    <small class="text-muted">Plain White Envelope</small>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="$@Model.DefaultShippingCostPwe" readonly>
                                    <small class="text-muted">Plain White Envelope</small>
                                }
                            </div>
                            <div class="col-md-3">
                                <label asp-for="DefaultShippingCostBmwt" class="form-label fw-bold">Shipping (BMWT)</label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="DefaultShippingCostBmwt" type="number" step="0.01" class="form-control">
                                    </div>
                                    <small class="text-muted">Bubble Mailer w/ Tracking</small>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="$@Model.DefaultShippingCostBmwt" readonly>
                                    <small class="text-muted">Bubble Mailer w/ Tracking</small>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Other Settings -->
                <div class="card mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-sliders"></i> Other Settings
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label asp-for="PriceStalenessThresholdDays" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <div class="input-group">
                                        <input asp-for="PriceStalenessThresholdDays" type="number" min="1" max="365" class="form-control">
                                        <span class="input-group-text">days</span>
                                    </div>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.PriceStalenessThresholdDays days" readonly>
                                }
                                <small class="text-muted">Cards priced older than this are flagged for repricing</small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ActiveExportPlatform" class="form-label fw-bold"></label>
                                @if (isEditable)
                                {
                                    <select asp-for="ActiveExportPlatform" class="form-select"
                                            asp-items="Html.GetEnumSelectList<FlipKit.Core.Models.Enums.ExportPlatform>()">
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" value="@Model.ActiveExportPlatform" readonly>
                                }
                                <small class="text-muted">Default platform for CSV exports</small>
                            </div>
                        </div>
                    </div>
                </div>

                @if (isEditable)
                {
                    <!-- Save Button -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save"></i> Save Settings
                        </button>
                    </div>
                }

            </form>

            <!-- Privacy & Data Handling -->
            <div class="card mt-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-lock"></i> Privacy &amp; Data Handling
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        FlipKit stores your inventory locally in a SQLite database. The features below contact third-party services only when you use them — and only with the data listed. Nothing else leaves your machine.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-sm table-borderless mb-3">
                            <thead class="small text-muted">
                                <tr>
                                    <th style="width: 22%;">Service</th>
                                    <th style="width: 28%;">Data sent</th>
                                    <th>Triggered by</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                <tr>
                                    <td>
                                        <strong>OpenRouter</strong><br>
                                        <span class="text-muted">openrouter.ai</span>
                                    </td>
                                    <td>Card images (JPEG, base64) + text prompt; or listing titles (text only) for eBay CSV enrichment.</td>
                                    <td>Scan, Bulk Scan, Import eBay listings. OpenRouter routes each request to the model provider you select (Google, OpenAI, Anthropic, etc.).</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>CardSight</strong><br>
                                        <span class="text-muted">api.cardsight.ai</span>
                                    </td>
                                    <td>Card images only (multipart upload).</td>
                                    <td>First-pass sports-card scanner when a CardSight key is configured. 750 free identifications/month; on miss or low confidence FlipKit falls back to OpenRouter.</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>ImgBB</strong><br>
                                        <span class="text-muted">api.imgbb.com</span>
                                    </td>
                                    <td>Card images only.</td>
                                    <td>CSV export with public-photo-URL upload (Whatnot, COMC). Skipped if no ImgBB key is configured.</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>eBay API</strong><br>
                                        <span class="text-muted">api.ebay.com, auth.ebay.com</span>
                                    </td>
                                    <td>Listing data (title, description, price, condition, category, photo URLs) + OAuth credentials.</td>
                                    <td>"Publish to eBay" actions. Only contacted when eBay credentials are configured and you initiate a publish.</td>
                                </tr>
                                <tr>
                                    <td>
                                        <strong>eBay / Terapeak deeplinks</strong><br>
                                        <span class="text-muted">www.ebay.com</span>
                                    </td>
                                    <td>Search keywords in URL (sent by your browser, not by FlipKit).</td>
                                    <td>"Pricing research" buttons open search URLs in your default browser.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-warning small mb-0 py-2">
                        <strong>No telemetry, analytics, or crash reporting.</strong>
                        FlipKit does not call home, does not collect usage data, and has no advertising integrations. API keys are stored locally and only sent to the service that owns them.
                    </div>

                    <p class="text-muted small mt-3 mb-0">
                        Draft v1 — last reviewed 2026-05-06. Each provider has its own terms; review them on the provider sites listed above.
                    </p>
                </div>
            </div>

            <!-- Legal Disclaimer -->
            <div class="card border-warning mt-4">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Important Legal Notice
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-2" style="line-height: 1.6;">
                        <strong>For Educational Use Only.</strong>
                        FlipKit is provided "AS IS" without warranties of any kind.
                    </p>
                    <p class="mb-0" style="line-height: 1.6;">
                        <strong>Use at Your Own Risk.</strong>
                        Always verify all card identifications, prices, and financial data independently.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Toggle password visibility
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const input = this.parentElement.querySelector('input');
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            });
        });

        // Test API connection
        document.querySelectorAll('.test-connection-btn').forEach(button => {
            button.addEventListener('click', async function() {
                const service = this.dataset.service;
                const originalHtml = this.innerHTML;

                // Show loading state
                this.disabled = true;
                this.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Testing...';

                try {
                    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    const response = await fetch('@Url.Action("TestConnection", "Settings")?service=' + service, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        this.innerHTML = '<i class="bi bi-check-circle"></i> Connected!';
                        this.classList.remove('btn-outline-primary', 'btn-outline-danger');
                        this.classList.add('btn-success');
                    } else {
                        this.innerHTML = '<i class="bi bi-x-circle"></i> ' + (result.message || 'Failed');
                        this.classList.remove('btn-outline-primary', 'btn-success');
                        this.classList.add('btn-outline-danger');
                    }

                    // Reset after 3 seconds
                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                        this.classList.remove('btn-success', 'btn-outline-danger');
                        this.classList.add('btn-outline-primary');
                        this.disabled = false;
                    }, 3000);

                } catch (error) {
                    this.innerHTML = '<i class="bi bi-x-circle"></i> Error';
                    this.classList.remove('btn-outline-primary', 'btn-success');
                    this.classList.add('btn-outline-danger');
                    this.disabled = false;

                    setTimeout(() => {
                        this.innerHTML = originalHtml;
                        this.classList.remove('btn-outline-danger');
                        this.classList.add('btn-outline-primary');
                    }, 3000);
                }
            });
        });
    </script>
}
